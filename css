*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg:        #0A0F1E;
    --surface:   #111827;
    --border:    #1E2D45;
    --accent:    #3B82F6;
    --accent-dim:#1D4ED8;
    --text:      #F1F5F9;
    --muted:     #64748B;
    --slate:     #94A3B8;
    --green:     #10B981;
    --mono:      'JetBrains Mono', monospace;
    --sans:      'Inter', sans-serif;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    min-height: 100vh;
    line-height: 1.6;
  }

  /* ── HEADER ── */
  header {
    border-bottom: 1px solid var(--border);
    padding: 18px 32px;
    display: flex;
    align-items: center;
    gap: 14px;
    position: sticky;
    top: 0;
    background: rgba(10,15,30,0.92);
    backdrop-filter: blur(8px);
    z-index: 100;
  }
  .logo-mark {
    width: 34px; height: 34px;
    background: var(--accent);
    border-radius: 8px;
    display: grid; place-items: center;
    font-family: var(--mono);
    font-size: 16px; font-weight: 600;
    color: #fff; flex-shrink: 0;
  }
  .logo-text { font-size: 15px; font-weight: 600; letter-spacing: -0.3px; }
  .logo-sub  { font-size: 12px; color: var(--muted); margin-left: 2px; }
  .badge {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    border: 1px solid var(--border);
    padding: 3px 10px;
    border-radius: 100px;
  }

  /* ── HERO ── */
  .hero {
    padding: 56px 32px 40px;
    max-width: 860px;
    margin: 0 auto;
  }
  .hero h1 {
    font-size: clamp(28px, 5vw, 44px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.8px;
    margin-bottom: 14px;
  }
  .hero h1 span { color: var(--accent); }
  .hero p {
    color: var(--slate);
    font-size: 15px;
    max-width: 520px;
    margin-bottom: 32px;
    line-height: 1.7;
  }

  /* ── CIPHER TABS ── */
  .cipher-tabs {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    padding: 0 32px;
    max-width: 860px;
    margin: 0 auto 32px;
  }
  .tab-btn {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--slate);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
    padding: 8px 18px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.15s;
    display: flex; align-items: center; gap: 8px;
  }
  .tab-btn .tab-num {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
  }
  .tab-btn:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .tab-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .tab-btn.active .tab-num { color: rgba(255,255,255,0.7); }

  /* ── MAIN CONTENT ── */
  .cipher-panel {
    max-width: 860px;
    margin: 0 auto 60px;
    padding: 0 32px;
    display: none;
  }
  .cipher-panel.active { display: block; }

  .panel-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: start;
  }

  /* ── TOOL CARD ── */
  .tool-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 24px;
  }
  .tool-card h2 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 18px;
    display: flex; align-items: center; gap: 10px;
  }
  .tool-card h2 .chip {
    font-family: var(--mono);
    font-size: 10px;
    background: rgba(59,130,246,0.15);
    color: var(--accent);
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 400;
  }

  label {
    display: block;
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    margin-bottom: 6px;
    letter-spacing: 0.4px;
  }

  textarea, input[type="text"], input[type="number"] {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-family: var(--mono);
    font-size: 13px;
    padding: 10px 12px;
    outline: none;
    resize: vertical;
    transition: border-color 0.15s;
  }
  textarea:focus, input:focus {
    border-color: var(--accent);
  }
  textarea { min-height: 88px; }

  .input-row {
    display: flex;
    gap: 10px;
    margin-bottom: 14px;
  }
  .input-row > div { flex: 1; }

  .btn-row {
    display: flex;
    gap: 8px;
    margin: 14px 0;
  }
  .btn {
    flex: 1;
    padding: 9px 16px;
    border-radius: 8px;
    border: none;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
  }
  .btn-primary {
    background: var(--accent);
    color: #fff;
  }
  .btn-primary:hover { background: var(--accent-dim); }
  .btn-secondary {
    background: transparent;
    color: var(--slate);
    border: 1px solid var(--border);
  }
  .btn-secondary:hover { border-color: var(--accent); color: var(--text); }

  .output-box {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px;
    min-height: 88px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--green);
    word-break: break-all;
    white-space: pre-wrap;
    position: relative;
    transition: border-color 0.15s;
  }
  .output-box.has-content { border-color: rgba(16,185,129,0.3); }

  .copy-btn {
    position: absolute; top: 8px; right: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--muted);
    font-family: var(--sans);
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 4px;
    cursor: pointer;
  }
  .copy-btn:hover { color: var(--text); }

  .field-mb { margin-bottom: 14px; }

  /* ── INFO CARD ── */
  .info-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 24px;
    position: sticky;
    top: 80px;
  }
  .info-card .cipher-icon {
    font-family: var(--mono);
    font-size: 32px;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 14px;
    line-height: 1;
  }
  .info-card h3 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 6px;
    letter-spacing: -0.3px;
  }
  .info-card .subtitle {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 18px;
    font-family: var(--mono);
  }
  .info-card p {
    font-size: 13.5px;
    color: var(--slate);
    line-height: 1.75;
    margin-bottom: 18px;
  }
  .info-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 18px 0;
  }
  .info-card h4 {
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 10px;
    letter-spacing: 0.3px;
  }
  .stat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  .stat-label { font-size: 12px; color: var(--muted); }
  .stat-val {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text);
    background: var(--bg);
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid var(--border);
  }
  .stat-val.bad  { color: #F87171; border-color: rgba(248,113,113,0.3); }
  .stat-val.ok   { color: #FCD34D; border-color: rgba(252,211,77,0.3); }
  .stat-val.good { color: var(--green); border-color: rgba(16,185,129,0.3); }

  .example-block {
    background: var(--bg);
    border-radius: 8px;
    padding: 12px;
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.8;
    border: 1px solid var(--border);
  }
  .ex-label { color: var(--muted); }
  .ex-plain { color: var(--text); }
  .ex-cipher { color: var(--green); }

  /* ── FOOTER ── */
  footer {
    border-top: 1px solid var(--border);
    padding: 24px 32px;
    text-align: center;
    font-size: 12px;
    color: var(--muted);
    font-family: var(--mono);
  }
  footer span { color: var(--accent); }

  /* ── RESPONSIVE ── */
  @media (max-width: 700px) {
    header { padding: 14px 16px; }
    .hero, .cipher-tabs, .cipher-panel { padding-left: 16px; padding-right: 16px; }
    .panel-grid { grid-template-columns: 1fr; }
    .info-card { position: static; }
    .hero { padding-top: 32px; }
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
